# =================== BACKEND (Express + Sequelize) ===================
# Connection string completa do Postgres do Supabase.
# Pegue em: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Exemplo:
# DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Porta do servidor Express
PORT=3000

# Se for usar Postgres local sem SSL, deixe DB_SSL vazio. Para Supabase é detectado automaticamente.
DB_SSL=

# =================== FRONTEND (Expo) ===================
# URL pública do projeto Supabase (Settings > API > Project URL)
EXPO_PUBLIC_SUPABASE_URL=

# Anon/Publishable key pública (Settings > API Keys > Publishable). NÃO use a secret key aqui.
# Formato novo:  sb_publishable_...
# Formato legado: eyJ...
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL do backend Express (usado pelo app)
EXPO_PUBLIC_API_URL=http://localhost:3000
